<Window x:Class="Gra_w_kości_2026_desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Gra_w_kości_2026_desktop"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="350" Background=" #ED27C121">
    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="kosc1" Margin="10px" Click="kosc1_Click" Background="Transparent" BorderThickness="0px">
                <Image Name="ob1" Source="/zdjecia/kosc0.png" Height="80px"></Image>
            </Button>
            <Button Name="kosc2" Margin="10px" Click="kosc2_Click" Background="Transparent" BorderThickness="0px">
                <Image Name="ob2" Source="/zdjecia/kosc0.png" Height="80px"></Image>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="kosc3" Margin="10px" Click="kosc3_Click" Background="Transparent" BorderThickness="0px">
                <Image Name="ob3" Source="/zdjecia/kosc0.png" Height="80px"></Image>
            </Button>
            <Button Name="kosc4" Margin="10px" Click="kosc4_Click" Background="Transparent" BorderThickness="0px">
                <Image Name="ob4" Source="/zdjecia/kosc0.png" Height="80px"></Image>
            </Button>
            <Button Name="kosc5" Margin="10px" Click="kosc5_Click" Background="Transparent" BorderThickness="0px">
                <Image Name="ob5" Source="/zdjecia/kosc0.png" Height="80px"></Image>
            </Button>
        </StackPanel>
        <Button Background="#ED275021" Foreground="white"  Name="przycisk" Width="60px" Margin="10px" Click="przycisk_Click">RZUT</Button>
        <TextBlock Name="Wynik" Width="100px" TextAlignment="Center" FontSize="40px">0</TextBlock>
    </StackPanel>
</Window>
